{
  "name": "abracodebra-crew-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "test:integration": "npm run test:integration -w server",
    "db:migrate": "npm run migrate -w server",
    "db:rollback": "npm run rollback -w server",
    "db:seed": "npm run seed -w server",
    "admin:create": "npm run admin:create -w server",
    "check": "node scripts/check.mjs",
    "format": "prettier --write client/src server/src server/database server/tests scripts *.json *.yaml *.md"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
